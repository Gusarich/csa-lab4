flowchart TD
    ir["IR from DataPath"] --> decoder["Opcode decoder"]
    decoder --> fsm["Hardwired FSM"]

    step["step counter"] --> fsm
    fsm --> step

    irq["IRQ line"] --> irq_logic["Precise IRQ check"]
    status["STATUS\nIE / IN_IRQ"] --> irq_logic
    irq_logic --> fsm

    pc["PC register"] --> pc_mux["PC source MUX"]
    epc["EPC register"] --> pc_mux
    decoder --> pc_mux
    fsm --> pc_mux
    pc_mux --> pc

    fsm --> epc
    fsm --> cause["CAUSE register"]
    fsm --> status

    cache_ready["cache_ready / cache_busy"] --> fsm
    cache_event["cache event"] --> fsm
    fsm --> signals["Control signal bundle\nto DataPath, cache, ports"]

    subgraph states["FSM states"]
        reset["RESET_VECTOR"]
        fetch["IF"]
        alu["EXEC_ALU"]
        addr["EXEC_ADDR"]
        mem["MEM"]
        branch["EXEC_BRANCH"]
        jump["EXEC_JUMP"]
        io["EXEC_IO"]
        sys["EXEC_SYS"]
        irq_enter["IRQ_ENTER"]
        irq_vector["IRQ_VECTOR"]
        halted["HALTED"]
        fault["FAULT"]
    end

    reset -->|"vector ready"| fetch
    reset -->|"missing / bad vector"| fault
    reset -->|"cache busy"| reset

    fetch --> alu
    fetch --> addr
    fetch --> branch
    fetch --> jump
    fetch --> io
    fetch --> sys
    fetch -->|"bad opcode / encoding"| fault
    fetch -->|"cache busy"| fetch

    addr --> mem
    mem -->|"cache ready"| irq_logic
    mem -->|"cache busy"| mem

    alu --> irq_logic
    branch --> irq_logic
    jump --> irq_logic
    io --> irq_logic
    sys -->|"nop / ei / di / iret"| irq_logic
    sys -->|"halt"| halted

    irq_logic -->|"IE and not IN_IRQ and IRQ"| irq_enter
    irq_logic -->|"otherwise"| fetch
    irq_enter --> irq_vector
    irq_vector -->|"handler ready"| fetch
    irq_vector -->|"missing / bad handler"| fault
    irq_vector -->|"cache busy"| irq_vector
